model student {
  id           Int            @id @default(autoincrement())
  name         String
  email        String         @unique(map: "Student_email_key")
  rollNo       String         @unique(map: "Student_rollNo_key")
  createdAt    DateTime       @default(now())
  batchId      Int?
  attendance   attendance[]
  notification notification[]
  batch        batch?         @relation(fields: [batchId], references: [id], map: "Student_batchId_fkey")

  @@index([batchId], map: "Student_batchId_fkey")
}

model teacher {
  id            Int          @id @default(autoincrement())
  name          String
  qualification String
  experience    Int
  userId        Int          @unique(map: "Teacher_userId_key")
  attendance    attendance[]
  user          user         @relation(fields: [userId], references: [id], map: "Teacher_userId_fkey")
}

model user {
  id        Int         @id @default(autoincrement())
  email     String      @unique(map: "User_email_key")
  createdAt DateTime    @default(now())
  password  String
  role      user_role
  address   String?
  city      String
  fullName  String
  gender    user_gender
  phone     String      @unique(map: "User_phone_key")
  updatedAt DateTime    @default(now())
  franchise franchise?
  teacher   teacher?
}

enum notification_type {
  GENERAL
  EXAM
  FEE
  ATTENDANCE
  ANNOUNCEMENT
}

enum user_role {
  ADMIN
  FRANCHISE
  TEACHER
  STUDENT
}

enum notification_recipientType {
  ALL
  STUDENTS
  TEACHERS
  FRANCHISES
  BATCH
  STUDENT
}

enum fee_status {
  PAID
  PARTIAL
  PENDING
}

enum attendance_status {
  PRESENT
  ABSENT
  LEAVE
}

enum user_gender {
  MALE
  FEMALE
  OTHER
}
