generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())

  name String

  email String @unique

  password String

  role Role

  teacher Teacher?

  franchise Franchise?

  createdAt DateTime @default(now())
}

model Teacher {
  id Int @id @default(autoincrement())

  qualification String

  name String

  experience Int

  specialization String?

  phone String?

  userId Int @unique

  user User @relation(fields: [userId], references: [id])

  attendances Attendance[]
}

model Franchise {
  id Int @id @default(autoincrement())

  name String

  email String @unique

  phone String?

  address String?

  userId Int @unique

  user User @relation(fields: [userId], references: [id])

  referrals Referral[]
}

model Referral {
  id Int @id @default(autoincrement())

  token String @unique

  role Role

  franchiseId Int

  franchise Franchise @relation(fields: [franchiseId], references: [id])

  isUsed Boolean @default(false)

  expiresAt DateTime

  createdAt DateTime @default(now())
}

enum Role {
  ADMIN

  FRANCHISE

  TEACHER

  STUDENT
}

model Inventory {
  id Int @id @default(autoincrement())

  itemName String

  description String?

  quantity Int

  price Float

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Student {
  id Int @id @default(autoincrement())

  name String

  email String @unique

  password  String

  dateOfBirth DateTime?

  gender String?

  phone String?

  address String?

  fatherName String?

  batchId Int?

  batch Batch? @relation(fields: [batchId], references: [id])

  notifications Notification[]

  attendances Attendance[]

  createdAt DateTime @default(now())
}

model Course {
  id Int @id @default(autoincrement())

  name String
  code String @unique

  description String?

  duration Int? // months

  fees Float?

  Batches Batch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Batch {
  id Int @id @default(autoincrement())

  name String

  courseId Int?

  course Course? @relation(fields: [courseId], references: [id])

  code String @unique

  description String?

  level String?

  startDate DateTime?

  endDate DateTime?

  maxStudents Int?

  notifications Notification[]

  //notifications Notification[]

  students Student[]

  attendances Attendance[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

enum NotificationType {
  GENERAL
  EXAM
  FEE
  ATTENDANCE
  ANNOUNCEMENT
}

enum RecipientType {
  ALL
  STUDENTS
  TEACHERS
  FRANCHISES
  BATCH
  STUDENT
}

model Notification {
  id Int @id @default(autoincrement())

  title   String
  message String

  type NotificationType @default(GENERAL)

  recipientType RecipientType

  batchId Int?
  batch   Batch? @relation(fields: [batchId], references: [id])

  studentId Int?
  student   Student? @relation(fields: [studentId], references: [id])

  createdBy Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Fee {
  id Int @id @default(autoincrement())

  studentId Int

  totalAmount Float

  paidAmount Float @default(0)

  pendingAmount Float

  status FeeStatus @default(PENDING)

  paymentDate DateTime?

  createdAt DateTime @default(now())
}

enum FeeStatus {
  PAID

  PARTIAL

  PENDING
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
}

model Attendance {
  id Int @id @default(autoincrement())

  studentId Int

  teacherId Int

  batchId Int

  attendanceDate DateTime @default(now())

  status AttendanceStatus

  remarks String?

  student Student @relation(fields: [studentId], references: [id])

  teacher Teacher @relation(fields: [teacherId], references: [id])

  batch Batch @relation(fields: [batchId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @default(now())

  @@unique([studentId, attendanceDate])
}
