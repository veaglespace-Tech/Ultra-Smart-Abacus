generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN

  FRANCHISE

  TEACHER

  STUDENT
}
model User {
  id Int @id @default(autoincrement())

  name String

  email String @unique

  password String

  otp String?

  otpExpiry DateTime?

  gender String?
  phone String?
  city String?
  address String?

  
  role Role

  parentGuardianName String?

  teacher Teacher?

  franchise Franchise?

  student Student?

  notificationReads NotificationRead[]
  createdInventories Inventory[] @relation("InventoryCreator")
  transfersSent      InventoryTransfer[] @relation("TransferSender")

  createdAt DateTime @default(now())
}

model Teacher {
  id Int @id @default(autoincrement())

  profilePhoto  String?
  documents     String? @db.LongText


  qualification String

  name String

  experience Int

  specialization String?

  phone String?

  userId Int @unique


  user User @relation(fields: [userId], references: [id])

  franchiseId Int?
  franchise   Franchise? @relation(fields: [franchiseId], references: [id])

  attendances Attendance[]
  exams       Exam[]
  salaries    Salary[]
}

model Franchise {
  id Int @id @default(autoincrement())

  name String

  email String @unique

  phone String?

  address String?

  userId Int @unique

  user User @relation(fields: [userId], references: [id])
  salaries Salary[]
  fees     Fee[]
  teachers Teacher[]
  students Student[]
  batches  Batch[]
  inventories Inventory[]
  inventoryTransfers InventoryTransfer[]
}



model Inventory {
  id Int @id @default(autoincrement())

  itemName String

  category String @default("General")

  sku String? @unique

  description String?

  quantity Int @default(0)

  minimumStock Int @default(10)

  unitPrice Float @default(0)

  price Float @default(0)

  status String @default("ACTIVE")

  createdBy Int?
  creator User? @relation("InventoryCreator", fields: [createdBy], references: [id])

  franchiseId Int?
  franchise Franchise? @relation(fields: [franchiseId], references: [id])

  transfers InventoryTransfer[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model InventoryTransfer {
  id Int @id @default(autoincrement())

  inventoryId Int
  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  franchiseId Int
  franchise Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)

  quantity Int

  remarks String?

  transferredBy Int
  user User @relation("TransferSender", fields: [transferredBy], references: [id])

  createdAt DateTime @default(now())
}

model Student {
  id Int @id @default(autoincrement())

  name String

  email String @unique

  profilePhoto  String?
  documents     String? @db.LongText


  password  String?

  rollNo String? @unique

  dateOfBirth DateTime?

  gender String?

  phone String?

  address String?

  fatherName String?

  batchId Int?

  batch Batch? @relation(fields: [batchId], references: [id])

  franchiseId Int?
  franchise   Franchise? @relation(fields: [franchiseId], references: [id])

  notifications Notification[]

  attendances Attendance[]
  examResults ExamResult[]

  userId Int? @unique

  user User? @relation(fields: [userId], references: [id])

  fees      Fee[]

  createdAt DateTime @default(now())
}

model Course {
  id Int @id @default(autoincrement())

  name String
  code String @unique

  description String?

  duration Int? // months

  fees Float?

  Batches Batch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Batch {
  id Int @id @default(autoincrement())

  name String

  courseId Int?

  course Course? @relation(fields: [courseId], references: [id])

  franchiseId Int?
  franchise   Franchise? @relation(fields: [franchiseId], references: [id])

  code String @unique

  description String?

  level String?

  startDate DateTime?

  endDate DateTime?

  maxStudents Int?

  notifications Notification[]

  students Student[]

  attendances Attendance[]
  exams       Exam[]
  fees        Fee[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

enum NotificationType {
  GENERAL
  EXAM
  FEE
  ATTENDANCE
  ANNOUNCEMENT
}

enum RecipientType {
  ALL
  STUDENTS
  TEACHERS
  FRANCHISES
  BATCH
  STUDENT
}

model Notification {
  id Int @id @default(autoincrement())

  title   String
  message String

  type NotificationType @default(GENERAL)

  recipientType RecipientType

  batchId Int?
  batch   Batch? @relation(fields: [batchId], references: [id])

  studentId Int?
  student   Student? @relation(fields: [studentId], references: [id])

  createdBy Int?

  isRead Boolean @default(false)

  reads NotificationRead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationRead {
  id             Int          @id @default(autoincrement())
  notificationId Int
  userId         Int
  readAt         DateTime     @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
}

model Fee {
  id           Int          @id @default(autoincrement())
  studentId    Int
  student      Student      @relation(fields: [studentId], references: [id])
  franchiseId  Int
  franchise    Franchise    @relation(fields: [franchiseId], references: [id])
  batchId      Int
  batch        Batch        @relation(fields: [batchId], references: [id])
  totalFee     Float
  paidAmount   Float        @default(0)
  dueAmount    Float
  dueDate      DateTime?
  status       FeeStatus    @default(PENDING)
  isActive     Boolean      @default(true)
  payments     FeePayment[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model FeePayment {
  id              Int        @id @default(autoincrement())
  feeId           Int
  fee             Fee        @relation(fields: [feeId], references: [id])
  amount          Float
  paymentDate     DateTime   @default(now())
  paymentMode     String     // Cash, UPI, Bank Transfer, Cheque
  referenceNumber String?
  remarks         String?
  receivedBy      Int        // Franchise User ID / Franchise ID
  receiptNumber   String     @unique
  createdAt       DateTime   @default(now())
}

enum FeeStatus {
  PAID
  PARTIAL
  PENDING
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
}

model Attendance {
  id Int @id @default(autoincrement())

  studentId Int

  teacherId Int

  batchId Int

  attendanceDate DateTime @default(now())

  status AttendanceStatus

  remarks String?

  student Student @relation(fields: [studentId], references: [id])

  teacher Teacher @relation(fields: [teacherId], references: [id])

  batch Batch @relation(fields: [batchId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([studentId, attendanceDate])
}

enum ExamType {
  WEEKLY
  MONTHLY
  LEVEL
  FINAL
}
enum ExamStatus {
  DRAFT
  SCHEDULED
  COMPLETED
  RESULT_PENDING
  PUBLISHED
  CANCELLED
}

model Exam {

  id Int @id @default(autoincrement())

  title String

  examCode String @unique

  description String?

  curriculumTrack String

  examType ExamType

  status ExamStatus @default(DRAFT)

  examDate DateTime

  startTime String?

  duration Int?

  totalMarks Int

  passingMarks Int

  

  teacherId Int

  batchId Int

  teacher Teacher @relation(fields:[teacherId],references:[id])

  batch Batch @relation(fields:[batchId],references:[id])

  results ExamResult[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([teacherId])

  @@index([batchId])

  @@index([examDate])

  @@index([status])
}

model ExamResult {
  id Int @id @default(autoincrement())

  examId Int

  studentId Int

  obtainedMarks Int

  percentage Float?

  grade String?

  isPassed Boolean @default(false)

  isAbsent Boolean @default(false)

  remarks String?

  publishedAt DateTime?

  exam Exam @relation(fields: [examId], references: [id])

  student Student @relation(fields: [studentId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([studentId])

  @@index([examId])

  @@unique([examId, studentId])
}

model Salary {
  id                Int       @id @default(autoincrement())
  teacherId         Int
  teacher           Teacher   @relation(fields: [teacherId], references: [id])
  franchiseId       Int?
  franchise         Franchise? @relation(fields: [franchiseId], references: [id])
  month             Int
  year              Int
  basicSalary       Float
  presentDays       Int       @default(0)
  dailyRate         Float     @default(500)
  bonus             Float     @default(0)
  deductions        Float     @default(0)
  netSalary         Float
  paymentStatus     String    @default("PENDING") // PENDING, PAID
  paymentDate       DateTime?
  paymentMode       String?   // Bank Transfer, UPI, Cash, Cheque, Other
  referenceNumber   String?
  remarks           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([teacherId, month, year])
}
