generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())

  name String

  email String @unique

  password String

  role Role

  teacher Teacher?

  franchise Franchise?

  createdAt DateTime @default(now())
}

model Teacher {
  id Int @id @default(autoincrement())

  qualification String

  name String

  experience Int

  userId Int @unique

  user User @relation(fields: [userId], references: [id])
}

model Franchise {
  id Int @id @default(autoincrement())

  name String

  email String @unique

  phone String?

  address String?

  userId Int @unique

  user User @relation(fields: [userId], references: [id])
}

enum Role {
  ADMIN

  FRANCHISE

  TEACHER

  STUDENT
}

model Inventory {
  id  Int      @id @default(autoincrement())

  itemName String

  description String?

  quantity Int

  price Float

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Student {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  rollNo    String   @unique

  notifications Notification[]

  createdAt DateTime @default(now())
}

model Course {
  id Int @id @default(autoincrement())

  name String
  code String @unique

  description String?

  duration Int? // months

  fees Float?

  Batches Batch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Batch {
  id   Int    @id @default(autoincrement())
  name String

  courseId Int?
  course   Course? @relation(fields: [courseId], references: [id])

  code        String  @unique
  description String?

  level String? // Beginner / Intermediate / Advanced

  startDate DateTime?
  endDate   DateTime?

  maxStudents Int?
 
  notifications Notification[]

}

enum NotificationType {
  GENERAL
  EXAM
  FEE
  ATTENDANCE
  ANNOUNCEMENT
}

enum RecipientType {
  ALL
  STUDENTS
  TEACHERS
  FRANCHISES
  BATCH
  STUDENT
}

model Notification {

  id Int @id @default(autoincrement())

  title String
  message String

  type NotificationType @default(GENERAL)

  recipientType RecipientType

  batchId Int?
  batch Batch? @relation(fields: [batchId], references: [id])

  studentId Int?
  student Student? @relation(fields: [studentId], references: [id])

  createdBy Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


