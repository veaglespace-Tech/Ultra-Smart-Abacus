model course {
  id          Int      @id @default(autoincrement())
  name        String
  code        String   @unique(map: "Course_code_key")
  description String?
  duration    Int?
  fees        Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  batch       batch[]
}

model fee {
  id            Int        @id @default(autoincrement())
  studentId     Int
  totalAmount   Float
  paidAmount    Float      @default(0)
  pendingAmount Float
  status        fee_status @default(PENDING)
  paymentDate   DateTime?
  createdAt     DateTime   @default(now())
}

model franchise {
  id      Int     @id @default(autoincrement())
  name    String
  email   String  @unique(map: "Franchise_email_key")
  phone   String?
  address String?
  userId  Int     @unique(map: "Franchise_userId_key")
  user    user    @relation(fields: [userId], references: [id], map: "Franchise_userId_fkey")
}

model inventory {
  id          Int      @id @default(autoincrement())
  itemName    String
  description String?
  quantity    Int
  price       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
}

model notification {
  id            Int                        @id @default(autoincrement())
  title         String
  message       String
  type          notification_type          @default(GENERAL)
  recipientType notification_recipientType
  batchId       Int?
  studentId     Int?
  createdBy     Int?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @default(now())
  batch         batch?                     @relation(fields: [batchId], references: [id], map: "Notification_batchId_fkey")
  student       student?                   @relation(fields: [studentId], references: [id], map: "Notification_studentId_fkey")

