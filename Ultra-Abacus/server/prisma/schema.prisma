generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FRANCHISE
  TEACHER
  STUDENT
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  rollNo    String   @unique
  createdAt DateTime @default(now())
}

model Course {
  id Int @id @default(autoincrement())

  name String
  code String @unique

  description String?

  duration Int? // months

  fees Float?

  Batches Batch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Batch {
  id   Int    @id @default(autoincrement())
  name String

  courseId Int?
  course   Course? @relation(fields: [courseId], references: [id])

  code        String  @unique
  description String?

  level String? // Beginner / Intermediate / Advanced

  startDate DateTime?
  endDate   DateTime?

  maxStudents Int?
}
